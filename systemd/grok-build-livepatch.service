[Unit]
Description=Grok Build livepatch — ban general-purpose/explore and rebuild
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/scripts/check-and-patch.sh
Nice=10
Environment=PATH=%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=CARGO_HOME=%h/.cargo
Environment=RUSTUP_HOME=%h/.rustup
# Point ~/.grok/bin/grok at the livepatched binary after each successful build.
# Without this, the ban only exists under ~/.local/opt/... while the CLI still
# uses the stock downloads channel. Set GROK_LIVEPATCH_REPLACE_BIN=0 to opt out.
Environment=GROK_LIVEPATCH_REPLACE_BIN=1

[Install]
WantedBy=default.target
